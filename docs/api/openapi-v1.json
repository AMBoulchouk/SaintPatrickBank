{
  "openapi": "3.1.0",
  "info": {
    "title": "SaintPatrickBK Core Financial Gateway API",
    "version": "1.0.0",
    "description": "Official REST API for SaintPatrickBK Payment Service Provider (PSPCP). Operates under BCRA and UIF regulatory frameworks in the Argentine Republic.",
    "contact": {
      "name": "SaintPatrickBK Engineering & Compliance",
      "email": "security@saintpatrickbk.com"
    }
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Production / Development Ingress Gateway"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/accounts": {
      "get": {
        "summary": "List Accounts for Authenticated Subject",
        "operationId": "listAccounts",
        "tags": ["Accounts"],
        "responses": {
          "200": { "description": "List of payment accounts retrieved successfully." },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/accounts/{id}": {
      "get": {
        "summary": "Get Account Details by ID",
        "operationId": "getAccountById",
        "tags": ["Accounts"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Account details retrieved successfully." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/accounts/{id}/balance": {
      "get": {
        "summary": "Get Real-Time Financial Balance",
        "operationId": "getAccountBalance",
        "tags": ["Accounts"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": { "description": "Account balance snapshot calculated from double-entry ledger." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/accounts/{id}/transactions": {
      "get": {
        "summary": "Get Paginated Account Journal History",
        "operationId": "getAccountTransactions",
        "tags": ["Accounts"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 100 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "default": 0 } }
        ],
        "responses": {
          "200": { "description": "Transaction history retrieved successfully." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/transfers/internal": {
      "post": {
        "summary": "Initiate Internal P2P Transfer (Test Environment / Guarded)",
        "operationId": "initiateInternalTransfer",
        "tags": ["Transfers"],
        "parameters": [
          { "name": "Idempotency-Key", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Transfer confirmed and posted to double-entry ledger." },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Cryptographically signed JSON Web Token (JWT HS256) issued by @spbk/identity. Contains authenticated subject identity, cryptographic signature, issuer, audience, and expiration."
      }
    },
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "description": "RFC 9457 Problem Details object (standard for HTTP error responses, superseding RFC 7807)",
        "required": ["type", "title", "status", "detail", "code", "instance", "correlationId", "timestamp"],
        "properties": {
          "type": { "type": "string", "format": "uri" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "detail": { "type": "string" },
          "code": { "type": "string" },
          "instance": { "type": "string" },
          "correlationId": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad Request - Validation or parameter format error",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
      },
      "Unauthorized": {
        "description": "Unauthorized - Missing or invalid cryptographic Bearer credentials",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
      },
      "Forbidden": {
        "description": "Forbidden - Insufficient permissions or unverified KYC status",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
      },
      "NotFound": {
        "description": "Not Found - Resource does not exist",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
      },
      "Conflict": {
        "description": "Conflict - Idempotency conflict with differing payload parameters",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
      },
      "UnprocessableEntity": {
        "description": "Unprocessable Entity - Financial business rule violation",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/ProblemDetails" } } }
      }
    }
  }
}
