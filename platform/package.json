{
  "name": "@spbk/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "SaintPatrickBK Financial Platform Monorepo (Node 24 LTS, TypeScript Strict, NestJS 11, PostgreSQL 18)",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @spbk/api dev",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm -r run typecheck",
    "docker:up": "./docker/up.sh",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "docker:ps": "docker compose -f docker/docker-compose.yml ps"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.0.7",
    "testcontainers": "^10.18.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
