{
  "name": "@spbk/api",
  "version": "0.1.0",
  "private": true,
  "description": "SaintPatrickBK Ingress API Gateway (NestJS 11 + Fastify)",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-fastify": "^11.0.11",
    "@spbk/accounts": "workspace:*",
    "@spbk/infrastructure": "workspace:*",
    "@spbk/ledger": "workspace:*",
    "@spbk/shared-kernel": "workspace:*",
    "fastify": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.5",
    "@nestjs/testing": "^11.0.11",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
