# =============================================================================
# SaintPatrickBK Environment Configuration Template
# IMPORTANT: Copy this file to .env and adjust for local environment.
# DO NOT commit real secrets or credentials to source control.
# =============================================================================

# Application Server
NODE_ENV=development
APP_PORT=3000
APP_HOST=127.0.0.1
LOG_LEVEL=debug

# PostgreSQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=saintpatrickbk_dev
DB_USER=spbk_app
DB_PASSWORD=spbk_app_dev_secret
DB_ADMIN_USER=spbk_admin
DB_ADMIN_PASSWORD=spbk_dev_secret
DB_POOL_MIN=2
DB_POOL_MAX=10

# Test Database Configuration (Used during automated integration tests)
TEST_DB_NAME=saintpatrickbk_test
TEST_DB_USER=spbk_app
TEST_DB_PASSWORD=spbk_app_dev_secret

# Security and Cryptography Placeholders (Phase 4+)
